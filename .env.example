# Google Sheets API
# Path to the service account JSON key file downloaded from Google Cloud Console
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=./service_account.json

# The ID of the Google Sheet (from the URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit)
GOOGLE_SHEET_ID=

# Anthropic API
# Get from: https://console.anthropic.com/api-keys
ANTHROPIC_API_KEY=

# SerpAPI
# Get from: https://serpapi.com/dashboard
SERPAPI_API_KEY=
